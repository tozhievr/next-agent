{
  "name": "harness-electron",
  "version": "0.47.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:dev": "node scripts/dev.cjs",
    "native:build": "python scripts/build_native.py",
    "desktop:build": "bun run icons && bun run native:build && bun run build && electron-builder --dir",
    "test:desktop": "node --test tests/native.test.cjs tests/installer.test.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check app components lib electron tests scripts/dev.cjs *.ts *.mjs *.json",
    "icons": "node scripts/icons.cjs",
    "dist": "bun run icons && bun run native:build && bun run build && node scripts/distribute.cjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-tooltip": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "tailwind-merge": "latest",
    "lucide-react": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tw-animate-css": "latest"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "electron": "latest",
    "electron-builder": "latest",
    "node-api-headers": "latest",
    "@playwright/test": "latest",
    "prettier": "latest"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "electron",
    "unrs-resolver"
  ],
  "main": "electron/main.cjs",
  "build": {
    "appId": "dev.nextagent.harness",
    "productName": "NextAgent Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "native/bin/${os}",
        "to": "native"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "nextagent-harness",
      "syncDesktopName": true
    },
    "mac": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "electronDist": "node_modules/electron/dist",
    "artifactName": "NextAgent-Harness-${version}-${os}-${arch}.${ext}"
  },
  "description": "Native next-agent Harness with Electron, Next.js and shadcn/ui",
  "author": "NextAgent contributors",
  "license": "MIT",
  "homepage": "https://github.com/tozhievr/next-agent",
  "desktopName": "dev.nextagent.harness"
}
