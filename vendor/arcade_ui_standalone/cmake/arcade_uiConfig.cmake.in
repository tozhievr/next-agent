@PACKAGE_INIT@
if(TARGET arcade_ui::arcade_ui)
    return()
endif()
# Build interface units with the consumer's compiler. Visual Studio generators
# cannot rebuild BMIs on IMPORTED targets, so public facades are normal targets.
set(_arcade_ui_prefix "${PACKAGE_PREFIX_DIR}")
foreach(_part core dx12 win32)
    if(_part STREQUAL "core")
        set(_archive arcade_ui)
        set(_module arcade_ui.cppm)
        set(_public arcade_ui)
    else()
        set(_archive arcade_ui_${_part})
        set(_module arcade_ui_${_part}.cppm)
        set(_public ${_part})
    endif()
    add_library(arcade_ui_binary_${_part} STATIC IMPORTED)
    set(_available "")
    foreach(_config Debug Release RelWithDebInfo MinSizeRel)
        set(_file "${_arcade_ui_prefix}/@CMAKE_INSTALL_LIBDIR@/${_config}/${_archive}.lib")
        if(EXISTS "${_file}")
            list(APPEND _available ${_config})
            string(TOUPPER ${_config} _upper)
            set_target_properties(arcade_ui_binary_${_part} PROPERTIES IMPORTED_LOCATION_${_upper} "${_file}")
        endif()
    endforeach()
    if(NOT _available)
        set(arcade_ui_FOUND FALSE)
        set(arcade_ui_NOT_FOUND_MESSAGE "No installed arcade_ui ${_part} archive")
        return()
    endif()
    set_target_properties(arcade_ui_binary_${_part} PROPERTIES IMPORTED_CONFIGURATIONS "${_available}")
    add_library(arcade_ui_sdk_${_part} STATIC)
    add_library(arcade_ui::${_public} ALIAS arcade_ui_sdk_${_part})
    target_sources(arcade_ui_sdk_${_part} PUBLIC FILE_SET modules TYPE CXX_MODULES
        BASE_DIRS "${_arcade_ui_prefix}/@CMAKE_INSTALL_DATADIR@/arcade_ui/modules"
        FILES "${_arcade_ui_prefix}/@CMAKE_INSTALL_DATADIR@/arcade_ui/modules/${_module}")
    target_include_directories(arcade_ui_sdk_${_part} PUBLIC "${_arcade_ui_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")
    target_compile_features(arcade_ui_sdk_${_part} PUBLIC cxx_std_23)
    target_compile_definitions(arcade_ui_sdk_${_part} PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(arcade_ui_sdk_${_part} PRIVATE arcade_ui_binary_${_part})
    if(MSVC)
        target_compile_options(arcade_ui_sdk_${_part} PUBLIC /utf-8 /Zc:__cplusplus)
    endif()
endforeach()
target_link_libraries(arcade_ui_sdk_core PRIVATE dwrite user32)
target_link_libraries(arcade_ui_sdk_dx12 PUBLIC arcade_ui::arcade_ui PRIVATE d3d12 d3dcompiler d2d1 dwrite windowscodecs ole32)
target_link_libraries(arcade_ui_sdk_win32 PUBLIC arcade_ui::arcade_ui PRIVATE imm32)
unset(_arcade_ui_prefix)
check_required_components(arcade_ui)
